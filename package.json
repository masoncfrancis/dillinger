{
  "name": "dillinger",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "electron:dev": "concurrently -k \"next dev -H 127.0.0.1 -p 3000\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build": "next build",
    "build:desktop": "next build && node scripts/prepare-electron-server.cjs",
    "start": "next start",
    "electron:start": "electron .",
    "electron:package": "npm run build:desktop && electron-builder",
    "start:test": "next start -H 127.0.0.1 -p 3005",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@sparticuz/chromium": "^143.0.4",
    "@types/dompurify": "^3.0.5",
    "breakdance": "^3.0.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "dropbox": "^10.34.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.38",
    "lucide-react": "^0.562.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-checkbox": "^1.1.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-texmath": "^1.0.0",
    "markdown-it-toc": "^1.1.0",
    "monaco-emacs": "^0.3.0",
    "monaco-vim": "^0.4.4",
    "next": "14.2.35",
    "puppeteer-core": "^24.39.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.4.0",
    "turndown": "^7.2.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.dillinger.editor",
    "productName": "Dillinger",
    "asar": true,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next-server"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
